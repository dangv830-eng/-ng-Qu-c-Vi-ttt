using System;
public class Person
{
    
    public string Id { get; init; }

 
    public string FullName { get; set; }

  
    public int BirthYear { get; set; }

    
    public Person(string id, string fullName, int birthYear)
    {
        Id = id;
        FullName = fullName;
        BirthYear = birthYear;
    }

    public int GetAge(int currentYear)
    {
        return currentYear - BirthYear;
    }
}


public class Employee : Person
{
   
    public decimal BaseSalary { get; set; }

    public Employee(
        string id,
        string fullName,
        int birthYear,
        decimal baseSalary
    ) : base(id, fullName, birthYear)
    {
        BaseSalary = baseSalary;
    }

 
    public virtual decimal CalculateIncome()
    {
        return BaseSalary;
    }
}



public sealed class Manager : Employee
{
   
    public decimal ResponsibilityAllowance { get; set; }

 
    public Manager(
        string id,
        string fullName,
        int birthYear,
        decimal baseSalary,
        decimal allowance
    ) : base(id, fullName, birthYear, baseSalary)
    {
        ResponsibilityAllowance = allowance;
    }

    
    public override decimal CalculateIncome()
    {
        return BaseSalary + ResponsibilityAllowance;
    }
}

class Program
{
    static void Main(string[] args)
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;

       
        int currentYear = 2026;


     

        Employee employee = new Employee(
            "NV001",
            "Dương Viết Tuấn ",
            2002,
            12000000
        );


    
        Manager manager = new Manager(
            "QL001",
            "Đặng Quốc Việt ",
            1995,
            20000000,
            5000000
        );


       

        Console.WriteLine("========================================");
        Console.WriteLine("          PHIẾU LƯƠNG NHÂN VIÊN");
        Console.WriteLine("========================================");

        Console.WriteLine("Mã nhân viên: " + employee.Id);
        Console.WriteLine("Họ tên: " + employee.FullName);
        Console.WriteLine("Tuổi: " + employee.GetAge(currentYear));
        Console.WriteLine(
            "Lương cơ bản: " +
            employee.BaseSalary.ToString("N0") +
            " VNĐ"
        );
        Console.WriteLine(
            "Thu nhập thực lĩnh: " +
            employee.CalculateIncome().ToString("N0") +
            " VNĐ"
        );


      

        Console.WriteLine();
        Console.WriteLine("========================================");
        Console.WriteLine("           PHIẾU LƯƠNG QUẢN LÝ");
        Console.WriteLine("========================================");

        Console.WriteLine("Mã quản lý: " + manager.Id);
        Console.WriteLine("Họ tên: " + manager.FullName);
        Console.WriteLine("Tuổi: " + manager.GetAge(currentYear));
        Console.WriteLine(
            "Lương cơ bản: " +
            manager.BaseSalary.ToString("N0") +
            " VNĐ"
        );
        Console.WriteLine(
            "Phụ cấp trách nhiệm: " +
            manager.ResponsibilityAllowance.ToString("N0") +
            " VNĐ"
        );
        Console.WriteLine(
            "Thu nhập thực lĩnh: " +
            manager.CalculateIncome().ToString("N0") +
            " VNĐ"
        );


       
        Console.WriteLine();
        Console.WriteLine("========================================");
        Console.WriteLine("Manager được khai báo là sealed.");
        Console.WriteLine("Không thể tạo lớp mới kế thừa từ Manager.");
        Console.WriteLine("========================================");

        Console.WriteLine();
        Console.WriteLine("Nhấn phím bất kỳ để kết thúc...");
        Console.ReadKey();
    }
}
